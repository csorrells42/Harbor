diff --git a/tests/test_harbor_form_readback.py b/tests/test_harbor_form_readback.py
new file mode 100644
index 0000000000000000000000000000000000000000..2522b4ba18e75d8d2c7e01343a643a7f10dda242
--- /dev/null
+++ b/tests/test_harbor_form_readback.py
@@ -0,0 +1,20 @@
+import asyncio
+import pymupdf
+from mcp_pdf.mixins_official.form_management import FormManagementMixin
+
+
+def test_filled_form_readback_keeps_page_count_after_close(tmp_path):
+    filename = tmp_path / 'form.pdf'
+    with pymupdf.open() as document:
+        page = document.new_page()
+        widget = pymupdf.Widget()
+        widget.field_name = 'project'
+        widget.field_type = pymupdf.PDF_WIDGET_TYPE_TEXT
+        widget.field_value = 'Harbor'
+        widget.rect = pymupdf.Rect(20, 20, 200, 50)
+        page.add_widget(widget)
+        document.save(filename)
+    result = asyncio.run(FormManagementMixin().extract_form_data(str(filename)))
+    assert result['success'] is True
+    assert result['file_info']['total_pages'] == 1
+    assert result['form_fields'][0]['field_value'] == 'Harbor'
